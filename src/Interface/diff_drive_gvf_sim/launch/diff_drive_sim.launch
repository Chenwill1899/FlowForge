<launch>
  <!-- Standalone demo: planar kinematic simulator + RViz marker visualization for a
       differential-drive (Scout-class) platform. Drive it by publishing geometry_msgs/Twist
       on cmd_topic, watch /sim/odom and the robot model markers in RViz. -->
  <arg name="init_x" default="0.0"/>
  <arg name="init_y" default="0.0"/>
  <arg name="init_yaw" default="0.0"/>
  <arg name="odom_topic" default="/sim/odom"/>
  <arg name="cmd_topic" default="/cmd_vel"/>
  <arg name="world_frame" default="world"/>
  <arg name="base_frame" default="base_link"/>
  <arg name="max_v" default="1.15"/>
  <arg name="min_w" default="-0.5235"/>
  <arg name="max_w" default="0.5235"/>
  <arg name="enable_rviz" default="true"/>

  <node pkg="diff_drive_gvf_sim" type="diff_drive_sim" name="diff_drive_sim" output="screen">
    <param name="sim/init_x" value="$(arg init_x)"/>
    <param name="sim/init_y" value="$(arg init_y)"/>
    <param name="sim/init_yaw" value="$(arg init_yaw)"/>
    <param name="sim/odom_topic" value="$(arg odom_topic)"/>
    <param name="sim/cmd_topic" value="$(arg cmd_topic)"/>
    <param name="sim/world_frame" value="$(arg world_frame)"/>
    <param name="sim/base_frame" value="$(arg base_frame)"/>
    <param name="sim/update_rate" value="50.0"/>
    <param name="sim/max_v" value="$(arg max_v)"/>
    <param name="sim/min_w" value="$(arg min_w)"/>
    <param name="sim/max_w" value="$(arg max_w)"/>
  </node>

  <node pkg="diff_drive_gvf_sim" type="car_model_visualization" name="car_model_visualization" output="screen">
    <param name="viz/odom_topic" value="$(arg odom_topic)"/>
    <param name="viz/frame_id" value="$(arg world_frame)"/>
  </node>

  <!-- Scout 2 model: URDF + robot_state_publisher (base_link -> wheels TF). -->
  <param name="robot_description"
         textfile="$(find diff_drive_gvf_sim)/urdf/scout2/scout2.urdf"/>
  <node pkg="robot_state_publisher" type="robot_state_publisher"
        name="robot_state_publisher" output="screen">
    <param name="publish_frequency" value="50.0"/>
  </node>

  <node if="$(arg enable_rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find diff_drive_gvf_sim)/config/rviz.rviz"/>
</launch>
